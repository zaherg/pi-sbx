FROM docker.io/sbx/pi-image:latest

# Run as root at build time, so n and Node are pinned (same as the v2 spec.yaml).
USER root
RUN npm install --global n@11.0.0 && n 26.13.0 \
 && node -e "process.exit(process.versions.node === '26.13.0' ? 0 : 1)"
# A global npm install puts bun on every user's PATH (root's ~/.bun would not).
RUN npm install --global --dangerously-allow-all-scripts bun@1.4.4 && bun --version
# Pinned like Node and Bun (same as the v2 spec.yaml); the installer verifies
# the release checksum. /usr/local/bin is on every user's PATH.
RUN curl -fsSL https://raw.githubusercontent.com/rtk-ai/rtk/master/install.sh \
 | RTK_VERSION=v1.2.0 RTK_INSTALL_DIR=/usr/local/bin sh

# Generated by sync.sh from the same host configuration as the v2 kit.
COPY --chown=1000:1000 files/home/.pi/agent /home/agent/.pi/agent

# npm 11 skips dependency install scripts unless allowed.
USER agent
RUN npm config set dangerously-allow-all-scripts true \
 && npm config set allow-remote all
# Pairs the binary with the synced stock pi extension; normally a no-op.
RUN rtk init --agent pi --global

ENTRYPOINT ["pi", "--approve"]
CMD []
